    # ========================================================
    # START SORT
    # ========================================================

    def start_sort(self):

        if self.sorting:
            return

        if not self.data:

            QMessageBox.information(
                self,
                "No Dataset",
                "Generate a dataset first."
            )

            return

        self.sorting = True

        self.paused = False

        self.reset_statistics()

        self.start_time = time.perf_counter()

        self.elapsed_seconds = 0

        algorithm = (
            self.algorithm_menu
            .currentText()
        )

        self.complexity_card.update_complexity(
            algorithm
        )

        self.set_status(
            "SORTING",
            WARNING
        )

        self.start_button.setEnabled(
            False
        )

        self.pause_button.setEnabled(
            True
        )


        self.algorithm_menu.setEnabled(
            False
        )

        self.progress_bar.setValue(
            0
        )

        self.progress_value.setText(
            "0%"
        )

        self.log(
            f"Running {algorithm}..."
        )

        if algorithm == "Bubble Sort":

            self.generator = (
                self.bubble_sort_generator()
            )

        elif algorithm == "Selection Sort":

            self.generator = (
                self.selection_sort_generator()
            )

        elif algorithm == "Insertion Sort":

            self.generator = (
                self.insertion_sort_generator()
            )

        elif algorithm == "Shell Sort":

            self.generator = (
                self.shell_sort_generator()
            )

        elif algorithm == "Merge Sort":

            self.generator = (
                self.merge_sort_generator()
            )

        self.timer.setInterval(
            self.speed
        )

        self.timer.start()

        self.clock_timer.start(
            50
        )

    # ========================================================
    # SORT PROCESS
    # ========================================================

    def process_sort_step(self):

        if not self.sorting:
            return

        if self.paused:
            return

        try:

            state = next(
                self.generator
            )

            self.apply_visual_state(
                state
            )

            self.update_progress()

        except StopIteration:

            self.finish_sort()

    # ========================================================
    # VISUAL STATE
    # ========================================================

    def apply_visual_state(
        self,
        state
    ):

        if state is None:
            return

        compare = state.get(
            "compare"
        )

        swapped = state.get(
            "swapped"
        )

        active = state.get(
            "active"
        )

        sorted_indices = state.get(
            "sorted"
        )

        self.canvas.set_data(
            self.data,
            compare=compare,
            swapped=swapped,
            active=active,
            sorted_indices=sorted_indices
        )

        self.update_dataset_info()

    # ========================================================
    # PROGRESS
    # ========================================================

    def update_progress(self):

        n = len(
            self.data
        )

        if n <= 1:
            return

        algorithm = (
            self.algorithm_menu
            .currentText()
        )

        if algorithm == "Bubble Sort":

            total = (
                n * (n - 1)
            ) // 2

        elif algorithm == "Selection Sort":

            total = (
                n * (n - 1)
            ) // 2

        elif algorithm == "Insertion Sort":

            total = n * n

        elif algorithm == "Shell Sort":

            total = n * n

        else:

            total = (
                n
                * max(
                    1,
                    n.bit_length()
                )
            )

        progress = min(
            99,
            int(
                self.steps
                / max(
                    1,
                    total
                )
                * 100
            )
        )

        self.progress_bar.setValue(
            progress
        )

        self.progress_value.setText(
            f"{progress}%"
        )

    # ========================================================
    # ELAPSED TIME
    # ========================================================

    def update_elapsed(self):

        if not self.sorting:
            return

        if self.start_time is None:
            return

        self.elapsed_seconds = (
            time.perf_counter()
            - self.start_time
        )

        minutes = int(
            self.elapsed_seconds // 60
        )

        seconds = (
            self.elapsed_seconds
            % 60
        )

        self.elapsed_label.setText(
            f"{minutes:02d}:{seconds:05.2f}"
        )

