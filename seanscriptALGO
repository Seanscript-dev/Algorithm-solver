class BackgroundWidget(QWidget):

    def __init__(
        self,
        image_path,
        parent=None
    ):

        super().__init__(
            parent
        )

        self.pixmap = QPixmap(
            image_path
        )

    def paintEvent(
        self,
        event
    ):

        painter = QPainter(
            self
        )

        painter.setRenderHint(
            QPainter.SmoothPixmapTransform
        )

        rect = self.rect()

        if self.pixmap.isNull():

            painter.fillRect(
                rect,
                QColor(BG)
            )

            return

        scaled = self.pixmap.scaled(
            rect.size(),
            Qt.KeepAspectRatioByExpanding,
            Qt.SmoothTransformation
        )

        x = (
            rect.width()
            - scaled.width()
        ) // 2

        y = (
            rect.height()
            - scaled.height()
        ) // 2

        painter.drawPixmap(
            x,
            y,
            scaled
        )

        # Dark overlay

        overlay = QColor(
            3,
            8,
            17,
            205
        )

        painter.fillRect(
            rect,
            overlay
        )


