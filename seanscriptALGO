    # ========================================================
    # GENERATE
    # ========================================================

    def generate(self):

        if self.sorting:
            return

        raw = (
            self.input_entry
            .text()
            .strip()
        )

        if not raw:

            QMessageBox.warning(
                self,
                "Dataset",
                "Please enter a dataset."
            )

            return

        try:

            values = [
                int(x.strip())
                for x in raw.split(",")
            ]

        except ValueError:

            QMessageBox.critical(
                self,
                "Invalid Dataset",
                "Enter integers separated by commas.\n\n"
                "Example:\n"
                "12, 4, 8, 2, 10, 6"
            )

            return

        if len(values) < 2:

            QMessageBox.warning(
                self,
                "Dataset",
                "Please enter at least 2 numbers."
            )

            return

        if len(values) > 40:

            QMessageBox.warning(
                self,
                "Dataset Limit",
                "Please use 40 numbers or fewer."
            )

            return

        self.data = values

        self.reset_statistics()

        self.canvas.set_data(
            self.data
        )

        self.update_dataset_info()

        self.progress_bar.setValue(
            0
        )

        self.progress_value.setText(
            "0%"
        )

        self.set_status(
            "READY",
            SUCCESS
        )

        self.log(
            f"Dataset loaded: {len(values)} elements."
        )

