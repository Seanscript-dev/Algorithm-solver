    # ========================================================
    # BUBBLE SORT
    # ========================================================

    def bubble_sort_generator(self):

        n = len(
            self.data
        )

        sorted_indices = set()

        for i in range(n):

            swapped_any = False

            for j in range(
                0,
                n - i - 1
            ):

                self.comparisons += 1

                self.steps += 1

                self.update_statistics()

                yield {
                    "compare": [
                        j,
                        j + 1
                    ],
                    "sorted": sorted_indices
                }

                if (
                    self.data[j]
                    > self.data[j + 1]
                ):

                    self.log(
                        f"Swap {self.data[j]} ↔ "
                        f"{self.data[j + 1]}"
                    )

                    self.data[j], self.data[j + 1] = (
                        self.data[j + 1],
                        self.data[j]
                    )

                    self.swaps += 1

                    self.steps += 1

                    self.update_statistics()

                    swapped_any = True

                    yield {
                        "swapped": [
                            j,
                            j + 1
                        ],
                        "sorted": sorted_indices
                    }

            sorted_indices.add(
                n - i - 1
            )

            yield {
                "sorted": sorted_indices
            }

            if not swapped_any:
                break

    # ========================================================
    # SELECTION SORT
    # ========================================================

    def selection_sort_generator(self):

        n = len(
            self.data
        )

        sorted_indices = set()

        for i in range(n):

            minimum = i

            for j in range(
                i + 1,
                n
            ):

                self.comparisons += 1

                self.steps += 1

                self.update_statistics()

                yield {
                    "compare": [
                        minimum,
                        j
                    ],
                    "active": minimum,
                    "sorted": sorted_indices
                }

                if (
                    self.data[j]
                    < self.data[minimum]
                ):

                    minimum = j

            if minimum != i:

                self.log(
                    f"Move {self.data[minimum]} "
                    f"to position {i}"
                )

                self.data[i], self.data[minimum] = (
                    self.data[minimum],
                    self.data[i]
                )

                self.swaps += 1

                self.steps += 1

                self.update_statistics()

                yield {
                    "swapped": [
                        i,
                        minimum
                    ],
                    "sorted": sorted_indices
                }

            sorted_indices.add(
                i
            )

            yield {
                "sorted": sorted_indices
            }

    # ========================================================
    # INSERTION SORT
    # ========================================================

    def insertion_sort_generator(self):

        n = len(
            self.data
        )

        sorted_indices = {
            0
        }

        for i in range(
            1,
            n
        ):

            key = self.data[i]

            j = i - 1

            yield {
                "active": i,
                "sorted": sorted_indices
            }

            while j >= 0:

                self.comparisons += 1

                self.steps += 1

                self.update_statistics()

                yield {
                    "compare": [
                        j,
                        j + 1
                    ],
                    "active": i,
                    "sorted": sorted_indices
                }

                if (
                    self.data[j]
                    <= key
                ):

                    break

                self.data[j + 1] = (
                    self.data[j]
                )

                self.steps += 1

                self.update_statistics()

                yield {
                    "swapped": [
                        j,
                        j + 1
                    ],
                    "active": j + 1,
                    "sorted": sorted_indices
                }

                j -= 1

            self.data[j + 1] = key

            sorted_indices.update(
                range(
                    i + 1
                )
            )

            yield {
                "sorted": sorted_indices
            }

    # ========================================================
    # SHELL SORT
    # ========================================================

    def shell_sort_generator(self):

        n = len(
            self.data
        )

        gap = n // 2

        while gap > 0:

            self.log(
                f"Gap size: {gap}"
            )

            for i in range(
                gap,
                n
            ):

                temp = self.data[i]

                j = i

                while j >= gap:

                    self.comparisons += 1

                    self.steps += 1

                    self.update_statistics()

                    yield {
                        "compare": [
                            j - gap,
                            j
                        ],
                        "active": j
                    }

                    if (
                        self.data[j - gap]
                        <= temp
                    ):

                        break

                    self.data[j] = (
                        self.data[j - gap]
                    )

                    self.steps += 1

                    self.update_statistics()

                    yield {
                        "swapped": [
                            j - gap,
                            j
                        ],
                        "active": j
                    }

                    j -= gap

                self.data[j] = temp

            gap //= 2

    # ========================================================
    # MERGE SORT
    # ========================================================

    def merge_sort_generator(self):

        sorted_indices = set()

        yield from self.merge_recursive(
            0,
            len(self.data) - 1,
            sorted_indices
        )

        yield {
            "sorted": set(
                range(
                    len(self.data)
                )
            )
        }

    def merge_recursive(
        self,
        left,
        right,
        sorted_indices
    ):

        if left >= right:
            return

        middle = (
            left + right
        ) // 2

        yield from self.merge_recursive(
            left,
            middle,
            sorted_indices
        )

        yield from self.merge_recursive(
            middle + 1,
            right,
            sorted_indices
        )

        yield from self.merge(
            left,
            middle,
            right,
            sorted_indices
        )

    def merge(
        self,
        left,
        middle,
        right,
        sorted_indices
    ):

        left_part = self.data[
            left:middle + 1
        ]

        right_part = self.data[
            middle + 1:right + 1
        ]

        i = 0

        j = 0

        k = left

        while (
            i < len(left_part)
            and j < len(right_part)
        ):

            self.comparisons += 1

            self.steps += 1

            self.update_statistics()

            yield {
                "compare": [
                    left + i,
                    middle + 1 + j
                ],
                "sorted": sorted_indices
            }

            if (
                left_part[i]
                <= right_part[j]
            ):

                self.data[k] = (
                    left_part[i]
                )

                i += 1

            else:

                self.data[k] = (
                    right_part[j]
                )

                j += 1

            self.steps += 1

            self.update_statistics()

            yield {
                "active": k,
                "sorted": sorted_indices
            }

            k += 1

        while i < len(left_part):

            self.data[k] = (
                left_part[i]
            )

            i += 1

            k += 1

            self.steps += 1

            self.update_statistics()

            yield {
                "active": k - 1,
                "sorted": sorted_indices
            }

        while j < len(right_part):

            self.data[k] = (
                right_part[j]
            )

            j += 1

            k += 1

            self.steps += 1

            self.update_statistics()

            yield {
                "active": k - 1,
                "sorted": sorted_indices
            }

    # ========================================================
    # FULLSCREEN
    # ========================================================

    def keyPressEvent(
        self,
        event
    ):

        if event.key() == Qt.Key_F11:

            self.toggle_fullscreen()

            return

        if event.key() == Qt.Key_Escape:

            if self.isFullScreen():

                self.showMaximized()

                return

        super().keyPressEvent(
            event
        )

    def toggle_fullscreen(self):

        if self.isFullScreen():

            self.showMaximized()

        else:

            self.showFullScreen()


