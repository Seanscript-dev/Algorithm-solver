class VisualizationCanvas(QWidget):

    def __init__(
        self,
        parent=None
    ):

        super().__init__(
            parent
        )

        self.data = []

        self.compare = set()

        self.swapped = set()

        self.active = None

        self.sorted_indices = set()

        self.setMinimumHeight(
            280
        )

        self.setSizePolicy(
            QSizePolicy.Expanding,
            QSizePolicy.Expanding
        )

    def set_data(
        self,
        data,
        compare=None,
        swapped=None,
        active=None,
        sorted_indices=None
    ):

        self.data = list(
            data
        )

        self.compare = (
            set(compare)
            if compare
            else set()
        )

        self.swapped = (
            set(swapped)
            if swapped
            else set()
        )

        self.active = active

        self.sorted_indices = (
            set(sorted_indices)
            if sorted_indices
            else set()
        )

        self.update()

    def paintEvent(
        self,
        event
    ):

        painter = QPainter(
            self
        )

        painter.setRenderHint(
            QPainter.Antialiasing
        )

        painter.setRenderHint(
            QPainter.SmoothPixmapTransform
        )

        rect = self.rect()

        painter.fillRect(
            rect,
            QColor(SURFACE)
        )

        if not self.data:

            painter.setPen(
                QColor(TEXT_MUTED)
            )

            painter.setFont(
                QFont(
                    "Segoe UI",
                    10
                )
            )

            painter.drawText(
                rect,
                Qt.AlignCenter,
                "Generate a dataset to begin visualization"
            )

            return

        width = rect.width()
        height = rect.height()

        left_margin = 30
        right_margin = 30
        top_margin = 42
        bottom_margin = 34

        graph_width = (
            width
            - left_margin
            - right_margin
        )

        graph_height = (
            height
            - top_margin
            - bottom_margin
        )

        max_value = max(
            self.data
        )

        if max_value <= 0:
            max_value = 1

        count = len(
            self.data
        )

        slot_width = (
            graph_width / count
        )

        baseline_y = (
            height
            - bottom_margin
        )

        # Baseline

        painter.setPen(
            QPen(
                QColor(BORDER),
                1
            )
        )

        painter.drawLine(
            left_margin,
            baseline_y,
            width - right_margin,
            baseline_y
        )

        # Bars

        for index, value in enumerate(
            self.data
        ):

            x = (
                left_margin
                + index * slot_width
            )

            bar_width = (
                slot_width
                * 0.72
            )

            bar_x = (
                x
                + (
                    slot_width
                    - bar_width
                ) / 2
            )

            bar_height = (
                value
                / max_value
                * graph_height
            )

            bar_y = (
                baseline_y
                - bar_height
            )

            color = QColor(
                BAR_DEFAULT
            )

            if index in self.sorted_indices:

                color = QColor(
                    BAR_SORTED
                )

            if index in self.compare:

                color = QColor(
                    BAR_COMPARE
                )

            if index in self.swapped:

                color = QColor(
                    BAR_SWAP
                )

            if self.active == index:

                color = QColor(
                    BAR_ACTIVE
                )

            # Glow

            glow = QColor(
                color
            )

            glow.setAlpha(
                35
            )

            painter.setBrush(
                QBrush(glow)
            )

            painter.setPen(
                Qt.NoPen
            )

            painter.drawRoundedRect(
                QRectF(
                    bar_x - 3,
                    bar_y - 3,
                    bar_width + 6,
                    bar_height + 6
                ),
                6,
                6
            )

            # Bar

            painter.setBrush(
                QBrush(color)
            )

            painter.drawRoundedRect(
                QRectF(
                    bar_x,
                    bar_y,
                    bar_width,
                    bar_height
                ),
                5,
                5
            )

            # Value

            painter.setPen(
                QColor(
                    TEXT_SECONDARY
                )
            )

            painter.setFont(
                QFont(
                    "Segoe UI",
                    8
                )
            )

            painter.drawText(
                QRectF(
                    bar_x - 10,
                    bar_y - 24,
                    bar_width + 20,
                    18
                ),
                Qt.AlignCenter,
                str(value)
            )

            # Index

            painter.setPen(
                QColor(
                    TEXT_MUTED
                )
            )

            painter.setFont(
                QFont(
                    "Segoe UI",
                    7
                )
            )

            painter.drawText(
                QRectF(
                    bar_x - 10,
                    baseline_y + 8,
                    bar_width + 20,
                    15
                ),
                Qt.AlignCenter,
                str(index)
            )


